{
  "name": "fomc-chair-strategy-game",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --experimental-strip-types scripts/simulation-smoke.ts",
    "check": "npm run test && npm run build",
    "report:trajectories": "node --experimental-strip-types scripts/trajectory-report.ts",
    "test:meeting-smoke": "node --experimental-strip-types scripts/meeting-smoke.ts",
    "test:committee-smoke": "node --experimental-strip-types scripts/committee-smoke.ts",
    "test:continuity-smoke": "node --experimental-strip-types scripts/continuity-smoke.ts",
    "test:session-smoke": "node --experimental-strip-types scripts/session-smoke.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
